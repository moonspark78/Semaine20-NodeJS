<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whispering</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="navbar">
        <span class="logo">Whispering</span>
        <a href="/about" class="about-link">About</a>
    </header>

    <div class="main-container">
        
        <button class="spread-btn" onclick="createWhisper()">Spread a whisper 🗣️</button>

        
        <div class="whispers-list">
            <% if (whispers.length === 0) { %>
                <p style="text-align: center; color: #666;">No whispers yet...</p>
            <% } %>

            <% whispers.forEach(whisper => { %>
                <div class="whisper-card">
                    <div class="card-actions">
                        
                        <button class="icon-btn edit-btn" 
                                data-id="<%= whisper.id %>" 
                                data-message="<%= whisper.message %>" 
                                onclick="editWhisper(this)" 
                                title="Modifier">✏️</button>
                        
                        <button class="icon-btn delete-btn" 
                                onclick="deleteWhisper('<%= whisper.id %>')" 
                                title="Supprimer">❌</button>
                    </div>
                    <p class="whisper-text"><%= whisper.message %></p>
                </div>
            <% }) %>
        </div>
    </div>
    <script>
        async function createWhisper() {
            const message = prompt("What's your whisper?");
            if (message) {
                const response = await fetch('/api/v1/whisper', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                if (response.ok) {
                    location.reload();
                }
            }
        }

        async function editWhisper(button) {
            const id = button.getAttribute('data-id');
            const currentMessage = button.getAttribute('data-message');
            
            const message = prompt("Edit the whisper:", currentMessage);
            if (message !== null) {
                const response = await fetch(`/api/v1/whisper/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                if (response.ok) {
                    location.reload();
                }
            }
        }

        async function deleteWhisper(id) {
            if (confirm("Are you sure you want to delete this whisper?")) {
                const response = await fetch(`/api/v1/whisper/${id}`, {
                    method: 'DELETE'
                });
                if (response.ok) {
                    location.reload();
                }
            }
        }
    </script>
</body>
</html>