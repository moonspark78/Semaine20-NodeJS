<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Upload d'image</title>
</head>
<body>
    <h1>Upload d'une image</h1>
    <form action="/upload" method="POST" enctype="multipart/form-data">
        <label for="image">Choisir une image :</label>
        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
            required
        >
        <button type="submit">Envoyer</button>
    </form>
    <% if (image) { %>
        <h2>Image envoyée :</h2>
        <p>Nom du fichier : <%= image.originalname %></p>
        <p>Taille : <%= image.size %> octets</p>
        <img
            src="/uploads/<%= image.filename %>"
            alt="Image envoyée"
            width="300"
        >
    <% } %>
</body>
</html>